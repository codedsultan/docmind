// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentVisibility {
  private
  public
}

enum IngestionStatus {
  pending
  processing
  ready
  failed
}

enum SourceType {
  pdf
  markdown
  txt
  html
  rtf
}

model Document {
  id          String             @id @default(uuid())
  userId      String
  title       String
  contentHash String
  rawText     String?
  sourceType  SourceType
  visibility  DocumentVisibility @default(private)
  status      IngestionStatus    @default(pending)
  isActive    Boolean            @default(true)
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  chunks Chunk[]

  @@unique([userId, contentHash])
  @@map("documents")
}

model Chunk {
  id                String   @id @default(uuid())
  documentId        String
  content           String
  contentHash       String
  chunkIndex        Int
  embeddingProvider String   @default("gemini-embedding-001")
  embedding         Unsupported("vector(768)")
  createdAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, contentHash])
  @@index([documentId])
  @@map("chunks")
}

enum RiskTier {
  read
  internal_write
  external_write
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes         Note[]
  tasks         Task[]
  toolCallAudits ToolCallAudit[]
  queryTraces   QueryTrace[]
  conversations Conversation[]

  @@map("users")
}

model Note {
  id            String   @id @default(uuid())
  userId        String
  content       String
  sourceQueryId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Task {
  id            String    @id @default(uuid())
  userId        String
  title         String
  description   String?
  dueAt         DateTime?
  done          Boolean   @default(false)
  sourceQueryId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model ToolCallAudit {
  id        String   @id @default(uuid())
  userId    String
  toolName  String
  riskTier  RiskTier
  params    Json
  result    Json?
  confirmed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tool_call_audits")
}

model QueryTrace {
  id               String   @id @default(uuid())
  userId           String
  query            String
  retrievedChunks  Json
  provider         String
  model            String
  latencyBreakdown Json
  cacheFlags       Json
  toolCallAuditIds String[]
  providerFallback Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("query_traces")
}

// ── Multi-turn agent chat history ───────────────────────────────────
// Scoped to /v1/agent/chat only (see plan doc). Tool-call/tool-result
// scaffolding is intentionally NOT persisted here — only user turns and
// the final assistant answer, so replayed history stays clean. Per-turn
// tool-call detail is already captured separately in ToolCallAudit.

enum MessageRole {
  user
  assistant
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  // Present only on assistant messages produced by a citation-bearing
  // tool result (see agent.service.ts finalAnswerOverride short-circuit).
  citations      Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
